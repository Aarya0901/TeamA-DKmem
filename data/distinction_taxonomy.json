{
  "taxonomy_version": "0.1",
  "description": "Team B distinction taxonomy for cross-lingual false-consolidation probes. class_id values match the distinction.class enum in docs/schemas/pairwise_eval.schema.json. Each class lists one or more languages where the distinction is grammaticalized or lexicalized, the possible surface values, the coarse English gloss those values collapse to, and 2-3 minimal-pair items with a gold same_entity label for Tier 1 probe construction.",
  "classes": [
    {
      "class_id": "kinship",
      "name": "Kinship specificity",
      "languages": [
        {
          "language": "hi",
          "language_name": "Hindi / Hinglish",
          "feature": "kin-relation-specific noun (marks parental line, generation, and gender)",
          "possible_values": ["chachi", "mami", "bua", "mausi", "dadi", "nani"],
          "english_gloss": "aunt / grandmother",
          "minimal_pairs": [
            {
              "entry_a": {"utterance": "meri chachi Pune mein rehti hai", "gloss": "user's aunt lives in Pune", "distinction_value": "chachi"},
              "entry_b": {"utterance": "meri mausi Pune mein rehti hai", "gloss": "user's aunt lives in Pune", "distinction_value": "mausi"},
              "same_entity_gold": false
            },
            {
              "entry_a": {"utterance": "meri dadi Jaipur aa rahi hain", "gloss": "user's grandmother is coming to Jaipur", "distinction_value": "dadi"},
              "entry_b": {"utterance": "meri nani Jaipur aa rahi hain", "gloss": "user's grandmother is coming to Jaipur", "distinction_value": "nani"},
              "same_entity_gold": false
            },
            {
              "entry_a": {"utterance": "meri bua ka phone aaya", "gloss": "user's aunt called", "distinction_value": "bua"},
              "entry_b": {"utterance": "meri mami ka phone aaya", "gloss": "user's aunt called", "distinction_value": "mami"},
              "same_entity_gold": false
            }
          ]
        }
      ]
    },
    {
      "class_id": "honorific_register",
      "name": "Honorific / register",
      "languages": [
        {
          "language": "hi",
          "language_name": "Hindi / Hinglish",
          "feature": "second-person pronoun register",
          "possible_values": ["tu", "tum", "aap"],
          "english_gloss": "you",
          "minimal_pairs": [
            {
              "entry_a": {"utterance": "tu kal aa rahi hai?", "gloss": "are you coming tomorrow?", "distinction_value": "tu"},
              "entry_b": {"utterance": "aap kal aa rahi hain?", "gloss": "are you coming tomorrow?", "distinction_value": "aap"},
              "same_entity_gold": false,
              "note": "tu marks an intimate/close addressee, aap a formal one; the two utterances plausibly address different people despite an identical English gloss."
            },
            {
              "entry_a": {"utterance": "tum kaha ja rahe ho?", "gloss": "where are you going?", "distinction_value": "tum"},
              "entry_b": {"utterance": "aap kaha ja rahe hain?", "gloss": "where are you going?", "distinction_value": "aap"},
              "same_entity_gold": false,
              "note": "tum (familiar) vs. aap (formal) plausibly address different people despite an identical English gloss."
            }
          ]
        },
        {
          "language": "de",
          "language_name": "German",
          "feature": "second-person pronoun register (T-V distinction)",
          "possible_values": ["du", "Sie"],
          "english_gloss": "you",
          "minimal_pairs": [
            {
              "entry_a": {"utterance": "Wie geht es dir?", "gloss": "how are you?", "distinction_value": "du"},
              "entry_b": {"utterance": "Wie geht es Ihnen?", "gloss": "how are you?", "distinction_value": "Sie"},
              "same_entity_gold": false,
              "note": "du addresses a close/informal relation, Sie a formal one; same gloss, plausibly different addressee."
