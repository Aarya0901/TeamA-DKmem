    {
      "class_id": "evidentiality",
      "name": "Evidentiality / hearsay",
      "languages": [
        {
          "language": "hi",
          "language_name": "Hindi / Hinglish",
          "feature": "lexical reportative marker (Hindi has no grammaticalized evidential suffix; reportative status is marked lexically)",
          "possible_values": ["suna hai ki... (heard that...)", "maine dekha ki... (I saw that...)"],
          "english_gloss": "[fact], simple past",
          "minimal_pairs": [
            {
              "entry_a": {"utterance": "suna hai wo Mumbai gaya", "gloss": "he went to Mumbai", "distinction_value": "reported/unconfirmed"},
              "entry_b": {"utterance": "maine dekha wo Mumbai gaya", "gloss": "he went to Mumbai", "distinction_value": "witnessed/confirmed"},
              "same_entity_gold": true,
              "note": "same referent and event; evidential status (hearsay vs. witnessed) is dropped by the gloss, so a confident merge/supersession silently upgrades an unconfirmed report to a confirmed fact."
            },
            {
              "entry_a": {"utterance": "kehte hain wo bimar hai", "gloss": "he is sick", "distinction_value": "reported/unconfirmed"},
              "entry_b": {"utterance": "maine khud dekha wo bimar hai", "gloss": "he is sick", "distinction_value": "witnessed/confirmed"},
              "same_entity_gold": true,
              "note": "same referent and fact; reportative vs. first-hand marking is dropped by the gloss."
            }
          ]
        },
        {
          "language": "tr",
          "language_name": "Turkish",
          "feature": "evidential past-tense suffix",
          "possible_values": ["-dı/-di (direct/witnessed past)", "-mış/-miş (reported/inferred past)"],
          "english_gloss": "[fact], simple past",
          "minimal_pairs": [
            {
              "entry_a": {"utterance": "Ali geldi", "gloss": "Ali arrived", "distinction_value": "-di (witnessed)"},
              "entry_b": {"utterance": "Ali gelmiş", "gloss": "Ali arrived", "distinction_value": "-miş (reported)"},
              "same_entity_gold": true,
              "note": "same referent and event; the witnessed-vs-reported distinction is destroyed by the English gloss."
            },
            {
              "entry_a": {"utterance": "Yağmur yağdı", "gloss": "it rained", "distinction_value": "-dı (witnessed)"},
              "entry_b": {"utterance": "Yağmur yağmış", "gloss": "it rained", "distinction_value": "-mış (reported)"},
              "same_entity_gold": true,
              "note": "same event; witnessed-vs-reported evidentiality dropped by the gloss."
            }
          ]
        }
      ]
    },
