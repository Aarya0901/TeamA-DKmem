              "entry_a": {"utterance": "yeh ghar mera hai", "gloss": "this is my house", "distinction_value": "yeh (near)"},
              "entry_b": {"utterance": "woh ghar mera hai", "gloss": "that is my house", "distinction_value": "woh (far)"},
              "same_entity_gold": false,
              "note": "proximal/distal deixis distinguishes two houses the user owns; the gloss drops which one is meant."
            }
          ]
        }
      ]
    }
