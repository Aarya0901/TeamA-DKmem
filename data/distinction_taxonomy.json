            {
              "entry_a": {"utterance": "Kommst du morgen?", "gloss": "are you coming tomorrow?", "distinction_value": "du"},
              "entry_b": {"utterance": "Kommen Sie morgen?", "gloss": "are you coming tomorrow?", "distinction_value": "Sie"},
              "same_entity_gold": false,
              "note": "same T-V contrast as above, second verb/context."
