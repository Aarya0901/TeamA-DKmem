              "entry_a": {"utterance": "ek botal doodh laaya", "gloss": "brought milk", "distinction_value": "botal (bottle)"},
              "entry_b": {"utterance": "ek gilaas doodh laaya", "gloss": "brought milk", "distinction_value": "gilaas (glass)"},
              "same_entity_gold": false,
              "note": "different container/quantity of milk on two occasions; risks being treated as a duplicate or supersession of the same fact."
            }
          ]
        }
      ]
    },
