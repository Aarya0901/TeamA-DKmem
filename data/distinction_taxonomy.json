          "possible_values": ["yeh (this/near)", "woh (that/far)", "kal (yesterday, with past tense)", "kal (tomorrow, with future tense)"],
          "english_gloss": "this/that; yesterday/tomorrow",
          "minimal_pairs": [
            {
              "entry_a": {"utterance": "kal woh Pune gaya tha", "gloss": "he went to Pune yesterday", "distinction_value": "kal + past tense = yesterday"},
